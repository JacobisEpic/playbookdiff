{
  "name": "playbookdiff",
  "version": "0.1.0",
  "description": "Read-only cross-agent configuration compatibility checker for Claude Code and Codex.",
  "keywords": [
    "agents",
    "agents-md",
    "ai-agents",
    "claude-code",
    "claude-md",
    "codex",
    "compatibility",
    "configuration",
    "mcp",
    "static-analysis"
  ],
  "homepage": "https://github.com/JacobisEpic/playbookdiff#readme",
  "bugs": {
    "url": "https://github.com/JacobisEpic/playbookdiff/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacobisEpic/playbookdiff.git",
    "directory": "packages/cli"
  },
  "bin": {
    "playbookdiff": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@playbookdiff/core": "workspace:*",
    "@playbookdiff/harness-claude": "workspace:*",
    "@playbookdiff/harness-codex": "workspace:*"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}

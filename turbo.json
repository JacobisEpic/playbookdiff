{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "playbookdiff#test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "@playbookdiff/action#test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    }
  }
}
